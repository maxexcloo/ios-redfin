--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -462,6 +462,13 @@
 static void sweet_scan_set(AppleCLCD *fb, bool on, const char *why);
 
 static AppleCLCD *sweet_fb_instance;    /* 0943: for the poke commands (p fc, p hz) */
+
+/* Display geometry has one owner. User surfaces arrive after this display registers. */
+bool
+sweet_framebuffer_is_display_size(uint32_t width, uint32_t height)
+{
+	return sweet_fb_instance != NULL && width == sweet_fb_instance->fLogicalW && height == sweet_fb_instance->fLogicalH;
+}
